From: LinDeX maintainers <noreply@localhost>
Subject: [PATCH] vaapi: add private opt-in decode EOS contract

This is a private, exact-opt-in integration contract. Unmodified FFmpeg and
GStreamer VA-API clients do not resolve or call its private symbol, so this
patch does not complete stock-application decode EOS support.

The default session clears the opt-in environment variable, and generic
VA-API behavior remains unchanged until a validated caller explicitly opts in.

---diff --git a/module/bin/stock-profile-session b/module/bin/stock-profile-session
index 3570ff7..b9152e8 100644
--- a/module/bin/stock-profile-session
+++ b/module/bin/stock-profile-session
@@ -67,6 +67,7 @@ unset ADVC_VAAPI_ENABLE_AVC ADVC_VAAPI_ENABLE_ENCODE ADVC_VAAPI_QCOM_IMPORT
 unset ADVC_VAAPI_ENABLE_HEVC ADVC_VAAPI_ENABLE_VP9
 unset ADVC_VAAPI_GPU_LINEAR_REPACK ADVC_VAAPI_OUTPUT
 unset ADVC_VAAPI_ENABLE_WRITE_EXPORT ADVC_VAAPI_ENABLE_GENERIC_UPLOAD
+unset ADVC_VAAPI_ENABLE_PRIVATE_DECODE_EOS
 unset ADVC_VAAPI_ALLOW_CPU_COPY ADVC_VAAPI_TRACE
 
 # Export ADVC only when the outer launcher has completed the fail-closed
diff --git a/scripts/test-video-acceleration-module.sh b/scripts/test-video-acceleration-module.sh
index e3be516..074a42c 100644
--- a/scripts/test-video-acceleration-module.sh
+++ b/scripts/test-video-acceleration-module.sh
@@ -62,11 +62,15 @@ require_text 'GST_REGISTRY_FORK=no' "$SESSION"
 require_text 'GST_REGISTRY=$XDG_RUNTIME_DIR/lindex-gstreamer-advc-v1.bin' "$SESSION"
 require_text 'unset GST_VAAPI_DRM_DEVICE GST_VAAPI_ALL_DRIVERS GST_REGISTRY_FORK GST_REGISTRY' "$SESSION"
 require_text 'unset ADVC_VAAPI_ENABLE_WRITE_EXPORT ADVC_VAAPI_ENABLE_GENERIC_UPLOAD' "$SESSION"
+require_text 'unset ADVC_VAAPI_ENABLE_PRIVATE_DECODE_EOS' "$SESSION"
 require_text 'unset ADVC_VAAPI_ENABLE_HEVC ADVC_VAAPI_ENABLE_VP9' "$SESSION"
 require_text 'unset ADVC_VAAPI_GPU_LINEAR_REPACK ADVC_VAAPI_OUTPUT' "$SESSION"
 require_text '[ -e /proc/self/fd ]' "$SESSION"
 require_text '[ -d /sys/class/drm/renderD128 ]' "$SESSION"
 require_text 'sha256sum -c SHA256SUMS' "$SESSION"
+if grep -Fq 'export ADVC_VAAPI_ENABLE_PRIVATE_DECODE_EOS=' "$SESSION"; then
+    fail 'private decode EOS must not be exported by the stock session'
+fi
 require_text 'gstreamer1.0-vaapi' "$INSTALL"
 require_text 'gstreamer1.0-plugins-bad' "$INSTALL"
 require_text 'gstreamer1.0-tools' "$INSTALL"
