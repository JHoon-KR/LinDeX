 scripts/diagnose-gstreamer-h264-decode.sh     | 290 ++++++++++++++++++
 .../test-gstreamer-h264-decode-diagnostic.sh  | 128 ++++++++
 .../gst-launch-fixture.sh                     |  54 ++++
 6 files changed, 518 insertions(+)
 create mode 100755 scripts/diagnose-gstreamer-h264-decode.sh
 create mode 100755 scripts/test-gstreamer-h264-decode-diagnostic.sh
